# /opt/ckauth/.env : read by docker compose itself (not passed to the app)
# public address of the app; email links are built from it
DOMAIN=ckauth.chiragdev.com
# hex only, it is embedded in DATABASE_URL: openssl rand -hex 32
POSTGRES_PASSWORD=
# the api's own database role (ckauth_api), which can't edit or delete the activity log. hex only, must differ from
# POSTGRES_PASSWORD: openssl rand -hex 32
API_DB_PASSWORD=
# set by the deploy workflows to the git sha currently running
API_TAG=latest
WEB_TAG=latest

{
  "name": "ckauth-api",
  "version": "1.0.0",
  "description": "CKAuth authentication API",
  "type": "module",
  "scripts": {
    "test": "node --import tsx --import ./test/env.ts --test-global-setup=test/global-setup.ts --test-concurrency=1 --test 'test/**/*.test.ts'",
    "test:coverage": "node --import tsx --import ./test/env.ts --test-global-setup=test/global-setup.ts --test-concurrency=1 --experimental-test-coverage --test-coverage-include='src/**' --test-coverage-exclude='src/scripts/**' --test-coverage-lines=95 --test-coverage-branches=83 --test-coverage-functions=85 --test 'test/**/*.test.ts'",
    "test:types": "tsc -p test/tsconfig.json",
    "check:pr": "node scripts/check-pr.js",
    "start": "node dist/index.js",
    "dev": "tsc-watch --onSuccess \"node dist/index.js\" | pino-pretty",
    "build": "tsc -p .",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:migrate:prod": "node dist/db/migrate.js",
    "admin": "node dist/scripts/manage-users.js",
    "seed:activity": "node dist/scripts/seed-activity.js",
    "drizzle:studio": "npx drizzle-kit studio",
    "docs:artifact": "node scripts/docs-artifact/build.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "packageManager": "pnpm@10.33.0",
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.3.0",
    "@types/node": "^26.6.3",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "1.0.0-rc.4",
    "knip": "6.42.1",
    "pino-pretty": "^13.2.0",
    "tsc-watch": "^7.2.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@imagekit/nodejs": "^7.12.1",
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "dotenv": "^18.0.4",
    "drizzle-orm": "1.0.0-rc.4",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.5.0",
    "pg": "^8.23.0",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "rate-limit-redis": "^6.0.1",
    "redis": "^6.3.0",
    "resend": "^6.31.0",
    "zod": "^4.6.7"
  }
}
